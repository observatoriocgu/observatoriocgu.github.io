# Dependências
node_modules/

# Resultado do build. Desde a Fase 1.5 o site é publicado pelo workflow
# deploy-pages.yml, que builda no CI — a pasta não é mais versionada.
evasao/dist/

# Os arquivos FINAIS que o site lê (D29). São artefato de publicação, como o
# dist/: `gerar_publicacao.py` os monta a partir de quatro arquivos versionados
# (dados.csv, dou.json, destinos_ranking.csv, alteracoes-registros.json)
# na hora de montar o site, e o `prebuild` do npm faz o mesmo na máquina local.
# Versioná-los custaria 425 KB reescritos a cada varredura do DOU e criaria uma
# segunda verdade — alguém teria de LEMBRAR de regerá-los depois de mexer nas
# entradas, e quem esquecesse publicaria dado velho em silêncio.
evasao/data/painel.csv
evasao/public/alteracoes.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente
.env
.env.*
!.env.example

# Snapshots mensais do Portal da Transparência. Os CSVs brutos do portal têm
# ~420 MB cada (o GitHub recusa acima de 100 MB) e os filtrados por AFFC somam
# ~70 MB — dado de trabalho, regenerável, não pertence ao repo.
# Gerar com: python evasao/scripts/filtrar_affc.py
evasao/data/historico_transparencia_cgu/

# Cache das páginas do DOU. Ato publicado é imutável, então o cache só evita
# rebaixar as mesmas ~3.000 páginas do backfill — é acelerador local, não dado.
evasao/data/cache_dou/

# Cache das buscas no rankingdosconcursos. Ao contrário do ato do DOU, a ficha
# de um candidato MUDA — vale 12 horas, e versionar cópia velha de dado que
# muda é pior que não ter cache nenhum. Cada página comprimida tem 218 KB.
evasao/data/cache_ranking/
evasao/data/cache_diarios/

# Cache das buscas web. Além de regenerável, ele guarda resposta de API PAGA:
# não versionar é também não publicar o que se comprou. A chave nunca está aqui
# — o nome do arquivo é derivado da CONSULTA, nunca da URL (ver buscaweb.py).
evasao/data/cache_buscaweb/

# Python (evasao/scripts/)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.sw?

# Ferramentas locais / artefatos de apoio
repomix-output.xml
.claude/settings.local.json
*.local

# Worktrees do Claude Code: repositórios git próprios, não pertencem a este.
.claude/worktrees/
